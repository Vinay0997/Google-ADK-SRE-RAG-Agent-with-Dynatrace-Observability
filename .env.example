# Google / ADK (Vertex AI)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
MODEL_NAME=gemini-3.8-flash
EVALUATOR_MODEL=gemini-3.8-flash

# Application
APP_NAME=sre_rag_observability
OTEL_SERVICE_NAME=google-adk-sre-agent
DEPLOYMENT_ENVIRONMENT=demo
TOP_K=3

# Dynatrace Classic SaaS OTLP base URL (no /v1/traces suffix here)
# Example: https://abc12345.live.dynatrace.com/api/v2/otlp
DYNATRACE_OTLP_ENDPOINT="https://irm77846.live.dynatrace.com/api/v2/otlp"
DYNATRACE_API_TOKEN=

# Optional. If false, local heuristic evaluation is used instead of Gemini evaluator.
USE_LLM_EVALUATOR=true
