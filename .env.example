# Google / ADK
# Streamlit Community Cloud: set FALSE and provide GOOGLE_API_KEY from Google AI Studio.
# Vertex AI: set TRUE and provide GOOGLE_CLOUD_PROJECT plus Application Default Credentials.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
MODEL_NAME=gemini-2.5-flash
EVALUATOR_MODEL=gemini-2.5-flash

# Application
APP_NAME=sre_rag_observability
OTEL_SERVICE_NAME=google-adk-sre-agent
DEPLOYMENT_ENVIRONMENT=demo
TOP_K=3

# Dynatrace Classic SaaS OTLP base URL (no /v1/traces suffix here)
# Example: https://abc12345.live.dynatrace.com/api/v2/otlp
DYNATRACE_OTLP_ENDPOINT="https://vft21626.live.dynatrace.com/api/v2/otlp"
DYNATRACE_API_TOKEN=

# Optional. If false, local heuristic evaluation is used instead of Gemini evaluator.
USE_LLM_EVALUATOR=true
